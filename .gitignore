# Codeflaws full dataset and generated execution artifacts
benchmark/datasets/codeflaws/raw/*
benchmark/datasets/codeflaws/processed/*
benchmark/datasets/codeflaws/downloads/*
benchmark/reports/*.json

# Reproducible but bulky Phase 6 per-case intermediates
benchmark/results/fault_localization_independent/coverage/*
benchmark/results/fault_localization_independent/rankings/*

# Phase 7 prompts, raw model responses, extracted patches, and local FL coverage
benchmark/artifacts/repair/*
benchmark/results/repair/coverage/*

# Phase 8 raw artifacts are retained locally; existing tracked Initial records stay frozen
benchmark/artifacts/repair_phase8/initial/*
benchmark/artifacts/repair_phase8/retry_control/*
benchmark/artifacts/repair_phase8/feedback/*

# Phase 9 generated inputs, binaries, and raw validation evidence
benchmark/artifacts/validation_phase9/*

!benchmark/datasets/codeflaws/raw/.gitkeep
!benchmark/datasets/codeflaws/processed/.gitkeep
!benchmark/datasets/codeflaws/downloads/.gitkeep
